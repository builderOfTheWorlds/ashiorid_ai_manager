# =================================================================
# Ashiorid AI Manager - Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =================================================================
# LLM Provider API Keys
# =================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# =================================================================
# Ollama Configuration (running on WSL host)
# =================================================================
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODELS=llama3.2:1b,llama3.2:3b,phi3:mini,nomic-embed-text

# =================================================================
# Database Configuration
# =================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ashiorid
POSTGRES_USER=ashiorid_user
POSTGRES_PASSWORD=change_me_in_production

# Connection string (auto-generated from above, or override)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =================================================================
# Redis Configuration
# =================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# =================================================================
# Qdrant Vector Database Configuration
# =================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# =================================================================
# Service Configuration
# =================================================================
ENVIRONMENT=development
DEBUG=true

# Service ports
LLM_PROXY_PORT=8001
LORE_RAG_PORT=8002
CHARACTER_AGENT_PORT=8003
SIMULATION_ENGINE_PORT=8004
AI_MANAGER_PORT=8005

# =================================================================
# Logging Configuration
# =================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
# Options: json (production), human (development)

# =================================================================
# Monitoring & Observability
# =================================================================
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
GRAFANA_PORT=3000

# =================================================================
# LLM Proxy Configuration
# =================================================================
LLM_DEFAULT_PROVIDER=ollama
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=3600

# =================================================================
# Rate Limiting
# =================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =================================================================
# Simulation Configuration
# =================================================================
SIMULATION_TICK_RATE=10
SIMULATION_MAX_AGENTS=1000
SIMULATION_GRID_SIZE=100

# =================================================================
# Security (For Production)
# =================================================================
# JWT_SECRET=your-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION=3600

# =================================================================
# Feature Flags
# =================================================================
ENABLE_AUTHENTICATION=false
ENABLE_KAFKA=false
ENABLE_WEB_UI=false

# =================================================================
# Development Tools
# =================================================================
TILT_ENABLED=true
HOT_RELOAD=true
